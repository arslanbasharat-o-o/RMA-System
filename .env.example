# Copy to .env.local for local development. Never use production values here.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Local PostgreSQL only. Replace this placeholder password with your local DB password.
DATABASE_URL=postgresql://postgres:change-me-local-only@localhost:5432/rma_system_dev
POSTGRES_PASSWORD=change-me-local-only

# Generate a unique value with: openssl rand -base64 32
SESSION_SECRET=
COOKIE_NAME=rma_session
SESSION_MAX_AGE_SECONDS=604800

# Seed creates this admin only when explicitly run; use a unique password of 16+ characters.
INITIAL_ADMIN_EMAIL=admin@rma-system.local
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Local Administrator

# Mock recognition is safe for local development and CI. It makes no paid API requests.
# Local development and CI default to mock; production uses the authenticated Lens API.
LENS_PROVIDER=mock
# Total visual upload/search deadline, 1000–120000 ms. No automatic timeout retries.
LENS_TIMEOUT_MS=60000
LENS_API_BASE_URL=
LENS_API_KEY=
LENS_API_POLL_INTERVAL_MS=1000
# upload_search calls <base>/upload then <base>/search; direct posts the image to the base URL.
LENS_API_MODE=upload_search
# Production images for the self-hosted API and worker packages; use versioned tags for rollbacks.
LENS_API_IMAGE=ghcr.io/arslanbasharat-o-o/google-lens-api:1.0.1
LENS_WORKER_IMAGE=ghcr.io/arslanbasharat-o-o/google-lens-scrapling-worker:1.0.1
RMA_DOCKER_NETWORK=rma-system_rma_network
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
WORKER_CONCURRENCY=2
POLL_INTERVAL_SECONDS=3

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.local/storage
MAX_UPLOAD_SIZE_BYTES=15728640
BUSINESS_TIMEZONE=UTC
